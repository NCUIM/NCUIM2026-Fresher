# 本機開發：docker compose up -d 後即可直接使用此連線字串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncuim?schema=public"

# Admin 帳號種子（僅供本機建立初始管理員使用）
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me"

# 寄信設定。未設定 SMTP_HOST 時，信件內容只會印到伺服器紀錄，不會真的寄出。
#
# ⚠️ 正式環境必須設定，否則找回身分的信不會送達，
#    而 ADR-0001 所述的十四天查看期就等同不存在。
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="NCUIM 新生歡迎會 <no-reply@example.com>"
