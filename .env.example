# 本機開發：docker compose up -d 後即可直接使用此連線字串
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ncuim?schema=public"

# 實機測試用的 HTTPS 隧道。到 ngrok.com 註冊免費帳號後，
# 於 Your Authtoken 頁面複製權杖貼在這裡，再執行 npm run tunnel。
#
# 為什麼需要：瀏覽器只在安全來源允許使用相機。手機連 http://192.168.x.x:3000
# 不算安全來源，掃描功能會直接被拒——見 ADR-0004。
NGROK_AUTHTOKEN=""

# 隧道要指向哪個埠。npm run tunnel 指 3000、tunnel:test 指 3001，
# 直接跑 docker compose 時才需要自己設。
# TUNNEL_PORT="3000"

# Admin 帳號種子（僅供本機建立初始管理員使用）
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me"

# 對外網址。寄出去的驗證信與找回連結會用它組出網址。
#
# ⚠️ 正式環境必須設定。沒設定時只能相信請求標頭，而標頭是客戶端可控的——
#    有人把 Host 換成自己的網域，找回連結就會寄到攻擊者手上。
#    開發時不設也能運作（會自動從標頭推導，隧道網址也正確）。
# PUBLIC_ORIGIN="https://your-domain.example"

# 寄信設定。未設定 SMTP_HOST 時，信件內容只會印到伺服器紀錄，不會真的寄出。
#
# ⚠️ 正式環境必須設定，否則找回身分的信不會送達，
#    而 ADR-0001 所述的十四天查看期就等同不存在。
#
# 用 Gmail 寄的話填以下這組（填完執行 npm run mail:test -- 你的信箱 驗證）：
#
#   SMTP_PASSWORD 不是你的 Google 登入密碼，而是「應用程式密碼」：
#     1. 帳戶必須先開啟兩步驟驗證，否則看不到這個功能
#     2. 到 https://myaccount.google.com/apppasswords 產生 16 碼密碼
#
#   SMTP_FROM 的信箱要與 SMTP_USER 相同。Gmail 會改寫或退回不一致的寄件者，
#   結果是信看似寄出、實際被擋。
#
#   免費 Gmail 帳號每天約 500 封上限。七十人的活動用不到，
#   但每次重寄驗證信都算一封，測試時不要無限重試。
#
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="十六碼應用程式密碼"
# SMTP_FROM="NCUIM 新生茶會 <you@gmail.com>"
#
# 埠與加密必須配對：587 搭 SMTP_SECURE="false"（STARTTLS）、
# 465 搭 SMTP_SECURE="true"（SSL）。交叉設定會卡住直到連線逾時。
