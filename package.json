{
  "name": "ncuim2026-fresher",
  "version": "1.0.0",
  "description": "NCUIM2026-Fresher 活動卡片收集系統",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose stop db",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mts",
    "db:reset-participants": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncuim_test?schema=public node scripts/reset-participants.mts",
    "db:purge": "node scripts/purge-expired.mts",
    "tunnel": "cross-env TUNNEL_PORT=3000 docker compose --profile tunnel up ngrok",
    "tunnel:test": "cross-env TUNNEL_PORT=3001 docker compose --profile tunnel up ngrok",
    "tunnel:down": "docker compose --profile tunnel rm -sf ngrok",
    "dev:test": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncuim_test?schema=public next dev -p 3001",
    "test:setup": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncuim_test?schema=public node scripts/setup-test-db.mts",
    "test": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncuim_test?schema=public TEST_BASE_URL=http://localhost:3001 node --test --test-concurrency=1 tests/**/*.test.mts",
    "smoke": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncuim_test?schema=public SMOKE_BASE_URL=http://localhost:3001 node scripts/smoke.mts",
    "rehearsal": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncuim_test?schema=public REHEARSAL_BASE_URL=http://localhost:3001 node scripts/rehearsal.mts",
    "mail:test": "node scripts/test-mail.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Youchenjiang/NCUIM2026-Fresher.git"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dotenv": "^17.4.2",
    "next": "^16.3.3",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cross-env": "^10.1.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
