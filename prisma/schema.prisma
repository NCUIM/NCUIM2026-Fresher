// 詞彙依循 /CONTEXT.md。相關決策見 /docs/adr/。
// 命名刻意與 CONTEXT.md 的詞彙一致，避免同義詞漂移。

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 起，連線 URL 不再寫在此處，改由 prisma.config.ts 提供給 Migrate，
// 執行期則由 PrismaClient 的 driver adapter 建立連線。見 lib/prisma.ts。
datasource db {
  provider = "postgresql"
}

enum EventStatus {
  ACTIVE
  ARCHIVED
}

enum Role {
  PARTICIPANT
  STAFF
}

enum TokenPurpose {
  VERIFY_EMAIL // 確認信箱可收信
  RECOVER_SESSION // 在新裝置上找回身分
}

enum AchievementType {
  SCAN_COUNT // 累計 Scan 達 N 人
  COLLECTED_COUNT // 累計被收集達 N 人
  EARLY_SCAN // Event 開始後 N 分鐘內完成第一次 Scan
  SCAN_ROLE // Scan 到具特定 Role 的人達 N 人
  TEAM_COLLECT // 收集同 Team 達 N 人（threshold = -1 代表「全部」）
}

model Event {
  id       String      @id @default(cuid())
  name     String
  passcode String // Q21：報到時的活動通關碼
  status   EventStatus @default(ACTIVE)
  startsAt DateTime

  // 封存與刪除。第一階段由 Admin 手動執行，purgeAfter 僅作為顯示給使用者的日期依據。
  archivedAt DateTime?
  purgeAfter DateTime? // 封存 + 14 天

  basePoints      Int @default(10) // 每筆 Collection 的基礎分，雙方對等
  leaderboardTopN Int @default(10) // Q31：只公開前 N 名
  teamCount       Int @default(0) // 0 代表本場不分組

  /// 是否讓站外的頁面讀得到這場的排行榜（/api/public/leaderboard）。
  ///
  /// 預設關閉：開啟等於讓全世界看得到這場所有人的暱稱與分數，而暱稱是
  /// 參與者自己取的——那該是主辦方明確按下的一個動作，不是預設行為。
  /// 對外只會有名次、暱稱、分數，不含真實姓名、信箱或內部 id。
  publicLeaderboard Boolean @default(false)

  /// 是否開放互相掃描收集。
  ///
  /// 與 status 正交，兩者關掉的東西不同：
  ///   status = ARCHIVED   報到與掃描都關，活動結束
  ///   scanningOpen = false 只關掃描，**報到仍然開著**
  ///
  /// 後者是為了「先讓大家陸續報到、主持人宣布開始才准掃」這種流程。
  /// 用旗標而不是新增一個 EventStatus：報到與掃描是兩件可以獨立開關的事，
  /// 塞進同一個列舉會變成要窮舉所有組合，而且封存還帶著 archivedAt 與
  /// purgeAfter 的語意，跟「暫停一下」不是同一個層次的狀態。
  ///
  /// **預設關閉。** 實際流程是「人陸續進場報到 → 主持人說明規則 → 宣布開始」，
  /// 開著建立活動等於一有人報到就能開始掃，而那通常早於主持人想要的時機。
  /// 忘記關的代價（遊戲提早開始、限時成就被浪費）比忘記開大得多——後者
  /// 在現場一秒就會有人反映。
  scanningOpen Boolean @default(false)

  /// 最近一次開放掃描的時刻。限時成就（「早鳥」）由它起算，而不是 startsAt。
  ///
  /// 兩者不同的理由：報到通常比開放收集早半小時以上，用 startsAt 起算的話
  /// 十五分鐘的窗口在還不能掃的時候就過完了——那個成就會變成沒有人拿得到。
  /// 尚未開放過時為 null，此時退回 startsAt。
  scanningOpenedAt DateTime?

  createdAt DateTime @default(now())

  entryCodes    EntryCode[]
  participants  Participant[]
  teams         Team[]
  scans         Scan[]
  collections   Collection[]
  impressions   Impression[]
  achievements  AchievementDef[]
  announcements Announcement[]

  hosts           AdminEvent[]
  activeForAdmins Admin[]     @relation("AdminActiveEvent")
}

/// Event 層級的註冊碼。掃描後建立身分並決定 Role。
/// 與 Participant.personalCode 是完全不同的東西，不可共用。
model EntryCode {
  id      String  @id @default(cuid())
  eventId String
  code    String  @unique
  role    Role    @default(PARTICIPANT)
  label   String? // 例如「一般參與者」「工作人員」

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Participant {
  id      String @id @default(cuid())
  eventId String

  /// 私密憑證，存於瀏覽器，用於識別身分。
  /// 絕不可等同 personalCode——否則每位收集過此人的人都能冒充他。
  sessionToken String @unique

  /// 公開碼，供他人掃描以建立 Collection。不可用於登入。
  personalCode String @unique

  role   Role    @default(PARTICIPANT)
  teamId String?

  // Profile
  nickname  String
  avatarUrl String?
  socialUrl String? // 一則 https 社群連結
  bio       String? // 一句話自我介紹
  icons     String[] // 三個個性化圖示的 key，純裝飾

  /// 真實姓名。**僅工作人員在後台可見，絕不出現在 Card 上。**
  /// 對外一律顯示 nickname——取暱稱的人往往正是不想讓全場看到本名的人。
  /// 現場核對身分、簽到表與獎品發放需要真名，暱稱在那些場合對應不到人。
  ///
  /// 資料庫層也是必填。應用層早就強制了（lib/validation.ts 的 min(1)），
  /// 而報到、編輯個人資料兩條寫入路徑都會擋——可空只是早期遷移留下的
  /// 狀態，讓型別一路帶著沒有意義的 `| null`。
  ///
  /// ⚠️ 改成 NOT NULL 之前資料庫裡不能有空值，否則 `prisma db push` 會失敗。
  realName String

  /// 卡片底色的 key（見 lib/card-colors.ts）。
  /// 自己選，別人收集到你時看到的就是這個顏色——這是卡片上唯一
  /// 由本人決定、且只影響別人視覺的欄位。未選時以預設色呈現。
  cardColor String?

  // 破冰用的話題線索。兩者都是選填——報到動線已經夠長，
  // 再加必填欄位會讓人在人潮中放棄。
  zodiac     String? // 星座，從固定選項挑選
  university String? // 大學，自由輸入

  // 找回身分。第一階段由工作人員於後台協助；第二階段改為 email 自助找回。
  // 見 docs/specs 的「簡化『身分找回』的後果」。
  email         String?
  emailVerified Boolean @default(false)

  createdAt DateTime @default(now())

  event               Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team                Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  avatar              Avatar?
  recoveryTokens      RecoveryToken[]
  scansInitiated      Scan[]              @relation("ScanInitiator")
  scansReceived       Scan[]              @relation("ScanTarget")
  collections         Collection[]        @relation("CollectionOwner")
  collectedBy         Collection[]        @relation("CollectionSubject")
  impressionsWritten  Impression[]        @relation("ImpressionAuthor")
  impressionsReceived Impression[]        @relation("ImpressionSubject")
  showcaseSlots       ShowcaseSlot[]      @relation("ShowcaseOwner")
  showcasedBy         ShowcaseSlot[]      @relation("ShowcaseSubject")
  achievements        AchievementEarned[]
  announcementReads   AnnouncementRead[]
  mailLogs            MailLog[]

  /// 一個信箱在同一場活動只能報到一次。
  ///
  /// 範圍限定在 Event 而非全域：身分本來就不跨活動延續（ADR-0001），
  /// 同一個人明年再參加時應該還能用同一個信箱報到。
  ///
  /// Postgres 視每個 NULL 為相異值，所以沒填信箱的人不受這條限制——
  /// 這正是我們要的：信箱是選填，不該因為留白而擋下第二個人報到。
  @@unique([eventId, email])
  @@index([eventId])
  @@index([teamId])
}

enum MailStatus {
  SENT
  FAILED
  /// 未設定 SMTP，信根本沒有嘗試寄出。
  /// 與 FAILED 分開記：這不是寄信出錯，是環境沒設定好，處理方式完全不同。
  SKIPPED
}

/// 每一次寄信的結果。
///
/// 存在的理由：寄信刻意不阻斷主流程（Q20），SMTP 掛掉時使用者照樣完成報到、
/// 看到成功畫面，信卻永遠不會到。沒有這張表，這件事要等到活動後第 8 天
/// 有人說「收不到找回信」才會被發現，而那時已經來不及補救。
///
/// 掛在 Participant 上是為了讓 14 天到期的清除能一併帶走它——
/// 這裡存了收件信箱，屬於個資，不能比本人的資料活得更久。
model MailLog {
  id            String     @id @default(cuid())
  participantId String?
  to            String
  subject       String
  status        MailStatus
  /// 失敗原因。只存訊息，不存堆疊——堆疊對現場的工作人員沒有意義。
  error         String?
  createdAt     DateTime   @default(now())

  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
}

/// 寄到信箱的一次性權杖。
///
/// 這是 ADR-0001 所述、對抗 iOS ITP 七天清除的補償機制：瀏覽器儲存失效後，
/// 使用者仍能透過信箱回到自己的收集成果。
///
/// 一次性且有到期時間——連結若外流（轉寄、共用裝置的信箱），
/// 長期有效的權杖等同於一把永久的身分鑰匙。
model RecoveryToken {
  id            String       @id @default(cuid())
  participantId String
  token         String       @unique
  purpose       TokenPurpose
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, purpose])
}

/// 頭像影像本體。
///
/// 獨立成表而非放在 Participant 上的欄位：Bytes 欄位會被一般查詢一併載入，
/// 而參與者清單、收集清單這類查詢每次都會撈出數十筆——把影像塞在同一張表
/// 等於每次列表都搬運幾 MB 的二進位資料。
///
/// 選擇存資料庫而非物件儲存的關鍵原因是保留期：十四天到期刪除 Participant 時，
/// cascade 會連影像一起清掉。放在外部儲存則需另寫清除程序，而漏刪的頭像
/// 就是殘留的個人資料。
model Avatar {
  participantId String   @id
  contentType   String
  data          Bytes
  updatedAt     DateTime @updatedAt

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

/// 由系統於報到時輪流指派（第一階段唯一模式）。
/// 因報到持續發生，隊伍人數會在活動過程中不斷增加——這正是 ADR-0002 存在的原因。
model Team {
  id      String  @id @default(cuid())
  eventId String
  number  Int
  name    String?

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members Participant[]

  @@unique([eventId, number])
}

/// 一次主動掃描。Scan 只歸屬於發起者，是衡量主動程度的唯一依據。
/// 一次 Scan 同時產生兩筆 Collection（雙向持有）。
///
/// 注意：發起方「不」影響基礎分。基礎分依 Collection 計算、雙方對等，
/// 各自以自己撰寫的 Impression 為條件。scannerId 的用途是 Admin 端的
/// 主動程度統計，以及 Achievement 範本 1、3 的達成判定。
model Scan {
  id        String @id @default(cuid())
  eventId   String
  scannerId String // 發起者。用於統計與成就判定，不決定基礎分歸屬
  scannedId String

  /// 兩個 participant id 排序後串接。
  /// 用途：讓 A→B 與 B→A 被視為同一次相遇，實作 Q29 的冪等要求。
  /// 若只對 (scannerId, scannedId) 設唯一鍵，B 事後回掃 A 會被誤判為新的相遇。
  pairKey String

  createdAt DateTime @default(now())

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanner     Participant  @relation("ScanInitiator", fields: [scannerId], references: [id], onDelete: Cascade)
  scanned     Participant  @relation("ScanTarget", fields: [scannedId], references: [id], onDelete: Cascade)
  collections Collection[]

  @@unique([eventId, pairKey])
  @@index([scannerId])
  @@index([scannedId])
}

/// 持有關係，對稱。一次 Scan 產生兩筆（雙方各一）。
/// 基礎分的計算單位：每筆 Collection 若其 owner 已對 subject 撰寫 Impression，
/// 即為 owner 貢獻一份 Event.basePoints。
model Collection {
  id        String @id @default(cuid())
  eventId   String
  ownerId   String
  subjectId String
  scanId    String

  createdAt DateTime @default(now())

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner   Participant @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  subject Participant @relation("CollectionSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  scan    Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([ownerId, subjectId])
  @@index([eventId])
}

/// 一段針對特定他人的短評。一律具名，僅收件人與 Admin 可讀（ADR-0003）。
/// 撰寫完成後，對應 Scan 的基礎分才入帳。
model Impression {
  id        String @id @default(cuid())
  eventId   String
  authorId  String
  subjectId String

  text String // 50 字上限於應用層驗證

  /// 由收件人（subject）設定，非作者。隱藏只影響收件人的檢視，不刪除資料——
  /// Admin 仍須能查看以進行審核。
  hiddenBySubject Boolean   @default(false)
  reportedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author  Participant @relation("ImpressionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject Participant @relation("ImpressionSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([authorId, subjectId])
  @@index([subjectId])
}

/// 九宮格，至多九格。公開可瀏覽。
/// 系統不得提供「我被幾個人放入 Showcase」的反向查詢或計數（ADR-0003）。
model ShowcaseSlot {
  id        String @id @default(cuid())
  ownerId   String
  subjectId String
  position  Int // 0–8

  owner   Participant @relation("ShowcaseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  subject Participant @relation("ShowcaseSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([ownerId, position])
  @@unique([ownerId, subjectId])
}

/// 第一階段由設定檔於建立 Event 時寫入，變更需重新部署。
/// 之後開放 Admin 後台自訂時，不需要改動資料結構。
model AchievementDef {
  id      String @id @default(cuid())
  eventId String
  key     String

  type      AchievementType
  threshold Int // TEAM_COLLECT 為 -1 時代表「全部隊員」
  points    Int
  hidden    Boolean         @default(false) // 隱藏成就達成前不得透露名稱、條件與進度

  title       String
  description String?
  targetRole  Role? // 僅 SCAN_ROLE 使用

  event  Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  earned AchievementEarned[]

  @@unique([eventId, key])
}

/// ADR-0002：達成狀態必須持久化，不可每次由當前資料推導。
/// 重算只新增此表的資料列，永不刪除。
model AchievementEarned {
  id               String @id @default(cuid())
  participantId    String
  achievementDefId String

  /// 達成當下的分值。之後 AchievementDef.points 變動不影響已達成者。
  pointsAwarded Int

  /// 達成當下的門檻。TEAM_COLLECT 記錄當時的隊伍人數，
  /// 使「集齊全隊」不因日後有人加入隊伍而失效。
  snapshotThreshold Int

  earnedAt DateTime @default(now())

  participant   Participant    @relation(fields: [participantId], references: [id], onDelete: Cascade)
  achievementDef AchievementDef @relation(fields: [achievementDefId], references: [id], onDelete: Cascade)

  @@unique([participantId, achievementDefId])
  @@index([participantId])
}

model Announcement {
  id        String   @id @default(cuid())
  eventId   String
  body      String
  createdAt DateTime @default(now())

  event Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reads AnnouncementRead[]

  @@index([eventId])
}

model AnnouncementRead {
  participantId  String
  announcementId String
  readAt         DateTime @default(now())

  participant  Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([participantId, announcementId])
}

/// 帳號預先建立，不開放註冊。不使用共用密碼——需能辨別是哪位 Admin 執行了操作。
/// 管理員的層級。與 Participant 的 Role 完全無關——那是活動內的身分，
/// 這是後台的權限。
enum AdminRole {
  /// 總管理員：看得到所有 Event，可以建立活動、指派主持人、管理管理員帳號。
  SUPER
  /// 活動主持人：只能操作被指派的 Event，看不到也碰不到其他場次。
  HOST
}

model Admin {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         AdminRole @default(HOST)
  createdAt    DateTime  @default(now())

  /// 目前正在操作的 Event。
  ///
  /// SUPER 用它在多場之間切換；HOST 一般就是自己被指派的那一場。
  /// 存在這裡而不是 AdminSession 上，是為了讓同一個人在手機與筆電上
  /// 看到的是同一場——活動當天在兩個裝置間切換卻操作到不同場次，
  /// 是會發錯公告的那種錯。
  activeEventId String?
  activeEvent   Event?  @relation("AdminActiveEvent", fields: [activeEventId], references: [id], onDelete: SetNull)

  sessions    AdminSession[]
  assignments AdminEvent[]
}

/// 哪位主持人負責哪一場。多對多：同一個人可能連續幾年都主持迎新。
///
/// SUPER 不需要在這裡出現——它的權限來自 role，不是指派。
model AdminEvent {
  adminId   String
  eventId   String
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([adminId, eventId])
  @@index([eventId])
}

/// 獨立成表而非存在 Admin 上，讓同一位管理員能同時從多個裝置登入，
/// 並且能單獨撤銷其中一個工作階段。
model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}
